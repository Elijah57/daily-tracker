# Local dev defaults work without any config.
# Copy this to .env and fill in values when testing with Turso.

# Turso (leave unset to use local SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth (change in production!)
JWT_SECRET=daily-tracker-dev-secret-change-me

# Server port (self-host only)
PORT=4000
