{
  "name": "daily-tracker",
  "version": "1.0.0",
  "description": "Daily task tracker for me and my friends",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "dev:server": "node server/src/index.js",
    "dev:client": "npm --prefix client run dev"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "netlify-cli": "^27.4.2",
    "vercel": "^59.10.0"
  }
}
